<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降の自動バックアップ・機種変更時の引き継ぎ。backup_rules.xml と同じものを除外する。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="sharedpref" path="drafts.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="sharedpref" path="drafts.xml" />
    </device-transfer>
</data-extraction-rules>

<Page
    x:Class="PadMapper.App.Views.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Diagnostics">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Diagnostics}" />

            <!-- 状態 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid x:Name="StatusGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="{DynamicResource Diag_Refresh}" Click="OnRefreshDevices" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Diag_OpenLogs}" Click="OnOpenLogs" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Diag_OpenData}" Click="OnOpenData" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Diag_RecentErrors}" />
            <Border Style="{StaticResource Card}">
                <ItemsControl x:Name="ErrorList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- デバイス一覧 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Diag_Devices}" />
            <CheckBox x:Name="ShowAllCheck" Content="{DynamicResource Diag_ShowAll}" Click="OnShowAllClick" Margin="0,0,0,6" />
            <Border Style="{StaticResource Card}">
                <ListView x:Name="DeviceList" MaxHeight="260" SelectionChanged="OnDeviceSelected">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="220" DisplayMemberBinding="{Binding Product}">
                                <GridViewColumn.Header><TextBlock Text="{DynamicResource Diag_ColProduct}" /></GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Header="VID:PID" Width="90" DisplayMemberBinding="{Binding VidPid}" />
                            <GridViewColumn Header="Usage" Width="80" DisplayMemberBinding="{Binding Usage}" />
                            <GridViewColumn Width="100" DisplayMemberBinding="{Binding Connection}">
                                <GridViewColumn.Header><TextBlock Text="{DynamicResource Diag_ColConnection}" /></GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="70" DisplayMemberBinding="{Binding Length}">
                                <GridViewColumn.Header><TextBlock Text="{DynamicResource Diag_ColLength}" /></GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="260" DisplayMemberBinding="{Binding Definition}">
                                <GridViewColumn.Header><TextBlock Text="{DynamicResource Diag_ColDefinition}" /></GridViewColumn.Header>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- 生レポート -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Diag_Dump}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="SelectedText" Style="{StaticResource Hint}" />
                    <WrapPanel Margin="0,6,0,6">
                        <ui:Button x:Name="DumpButton" Content="{DynamicResource Diag_StartDump}" Appearance="Primary" Click="OnToggleDump" Margin="0,0,8,0" />
                        <CheckBox x:Name="DirectCheck" Content="{DynamicResource Diag_DirectRead}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Diag_DumpHint}" Margin="0,0,0,6" />
                    <TextBlock x:Name="RateText" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="IndexText" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="HexText" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                    <TextBlock x:Name="BitsText" Style="{StaticResource Mono}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBox x:Name="HistoryBox" Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas, MS Gothic" FontSize="12" Height="140"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </StackPanel>
            </Border>

            <!-- ウィザード -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Diag_Wizard}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Diag_WizardHint}" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource Diag_Target}" Margin="0,0,8,0" />
                        <ComboBox x:Name="TargetCombo" MinWidth="140" Margin="0,0,8,0" SelectionChanged="OnTargetChanged" />
                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource Diag_Format}" Margin="0,0,8,0" />
                        <ComboBox x:Name="FormatCombo" MinWidth="80" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource Diag_Scale}" Margin="0,0,8,0" />
                        <TextBox x:Name="ScaleBox" Width="90" Text="0.061" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <Button x:Name="IdleButton" Content="{DynamicResource Diag_RecordIdle}" Click="OnRecordIdle" Margin="0,0,8,0" />
                        <Button x:Name="ActiveButton" Content="{DynamicResource Diag_RecordActive}" Click="OnRecordActive" Margin="0,0,8,0" />
                        <Button x:Name="AssignButton" Content="{DynamicResource Diag_Assign}" Click="OnAssign" />
                    </WrapPanel>
                    <TextBlock x:Name="WizardStatus" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <TextBox x:Name="DefinitionBox" IsReadOnly="True" FontFamily="Consolas, MS Gothic" FontSize="12" Height="200"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="MissingText" Style="{StaticResource Hint}" Margin="0,4,0,6" />
                    <CheckBox x:Name="VerifiedCheck" Content="{DynamicResource Diag_Verified}" Click="OnVerifiedClick" Margin="0,0,0,6" />
                    <WrapPanel>
                        <ui:Button Content="{DynamicResource Diag_SaveDefinition}" Appearance="Primary" Click="OnSaveDefinition" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Diag_ExportMarkdown}" Click="OnExportMarkdown" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Diag_StartFromBuiltin}" Click="OnStartFromBuiltin" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Diag_StartOver}" Click="OnStartOver" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Diag_DeleteLearned}" Click="OnDeleteLearned" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

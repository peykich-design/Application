<Page
    x:Class="PadMapper.App.Views.Pages.ControllerSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Controller setup">
    <StackPanel Margin="24,8,24,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Setup}" />
        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource Setup_Intro}" Margin="0,0,0,12" />

        <!-- デバイスの選択 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource Setup_Device}" Margin="0,0,8,8" />
                    <ComboBox x:Name="DeviceCombo" MinWidth="320" Margin="0,0,8,8" DisplayMemberPath="Title" SelectionChanged="OnDeviceChanged" />
                    <Button Content="{DynamicResource Diag_Refresh}" Click="OnRefresh" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock x:Name="DeviceDetail" Style="{StaticResource Hint}" />
                <CheckBox x:Name="BackButtonsCheck" Content="{DynamicResource Setup_IncludeBack}" IsChecked="True" Margin="0,8,0,0" />
                <WrapPanel Margin="0,10,0,0">
                    <ui:Button x:Name="StartButton" Content="{DynamicResource Setup_Start}" Appearance="Primary" Click="OnStart" Margin="0,0,8,0" />
                    <TextBlock x:Name="NoDeviceText" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{DynamicResource Setup_NoDevice}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 手順 -->
        <Border x:Name="StepCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="24,20">
            <StackPanel>
                <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,4,0,16" />
                <TextBlock x:Name="PromptText" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SubText" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" />
                <TextBlock x:Name="DetectText" FontSize="16" Margin="0,12,0,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="NoInputText" Style="{StaticResource Label}" Margin="0,12,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Text="{DynamicResource Setup_NoInput}" Visibility="Collapsed" />
                <WrapPanel Margin="0,16,0,0">
                    <Button Content="{DynamicResource Setup_Back}" Click="OnBack" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Setup_Skip}" Click="OnSkip" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Setup_Restart}" Click="OnRestart" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Setup_Cancel}" Click="OnCancel" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 完了 -->
        <Border x:Name="DoneCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="24,20">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{DynamicResource Setup_Done}" />
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Setup_DoneHint}" Margin="0,6,0,12" />
                <WrapPanel>
                    <ui:Button Content="{DynamicResource Setup_Save}" Appearance="Primary" Click="OnSave" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Setup_Restart}" Click="OnRestart" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Setup_Cancel}" Click="OnCancel" />
                </WrapPanel>
                <TextBlock x:Name="SavedText" Style="{StaticResource Label}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- 決まった割り当て -->
        <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionTitle}" Text="{DynamicResource Setup_Results}" Visibility="Collapsed" />
        <Border x:Name="ResultCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <ItemsControl x:Name="ResultList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding}" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Setup_Footer}" Margin="4,8,0,0" />
    </StackPanel>
</Page>

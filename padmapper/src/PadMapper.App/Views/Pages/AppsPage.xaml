<Page
    x:Class="PadMapper.App.Views.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Apps">
    <StackPanel Margin="24,8,24,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Apps}" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Apps_Current}" />
                <TextBlock x:Name="CurrentText" Style="{StaticResource Value}" />
                <TextBlock x:Name="CurrentPath" Style="{StaticResource Hint}" />
                <WrapPanel Margin="0,8,0,0">
                    <ComboBox x:Name="BindProfileCombo" MinWidth="200" DisplayMemberPath="Name" Margin="0,0,8,0" />
                    <ui:Button Content="{DynamicResource Apps_BindNow}" Appearance="Primary" Click="OnBindNow" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Apps_BindNowHint}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource Apps_Default}" />
                    <ComboBox x:Name="DefaultCombo" Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left" MinWidth="200" DisplayMemberPath="Name" SelectionChanged="OnDefaultChanged" />
                </Grid>
                <CheckBox x:Name="NotifyCheck" Content="{DynamicResource Apps_Notify}" Click="OnNotifyClick" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Apps_Rules}" />
        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Apps_RulesHint}" Margin="0,0,0,6" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <ListBox x:Name="RuleList" MinHeight="120" MaxHeight="260" SelectionChanged="OnRuleSelected" />
                <WrapPanel Margin="0,6,0,6">
                    <Button Content="{DynamicResource Apps_Add}" Click="OnAdd" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Common_Delete}" Click="OnRemove" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Apps_Up}" Click="OnUp" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Apps_Down}" Click="OnDown" />
                </WrapPanel>
                <Grid x:Name="RuleEditor">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{DynamicResource Apps_Enabled}" />
                    <CheckBox x:Name="EnabledCheck" Grid.Column="1" Click="OnRuleEdited" Margin="0,4" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{DynamicResource Apps_Exe}" />
                    <TextBox x:Name="ExeBox" Grid.Row="1" Grid.Column="1" TextChanged="OnRuleEdited" Margin="0,4" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{DynamicResource Apps_Title}" />
                    <TextBox x:Name="TitleBox" Grid.Row="2" Grid.Column="1" TextChanged="OnRuleEdited" Margin="0,4" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{DynamicResource Apps_Path}" />
                    <TextBox x:Name="PathBox" Grid.Row="3" Grid.Column="1" TextChanged="OnRuleEdited" Margin="0,4" />
                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{DynamicResource Apps_Profile}" />
                    <ComboBox x:Name="RuleProfileCombo" Grid.Row="4" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="OnRuleEdited" Margin="0,4" />
                    <TextBlock x:Name="RuleErrors" Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,4" />
                </Grid>
                <ui:Button Content="{DynamicResource Common_Save}" Appearance="Primary" Click="OnSave" Margin="0,6,0,0" />
                <TextBlock x:Name="DirtyText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>

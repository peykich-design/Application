<Window
    x:Class="PadMapper.App.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PadMapper Overlay"
    Width="360"
    SizeToContent="Height"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Border Background="#E6202020" BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="10" Padding="12">
        <StackPanel>
            <TextBlock Text="PadMapper" Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Foreground="#FFBBBBBB" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap" />
            <ItemsControl x:Name="Items" />
            <TextBlock x:Name="HelpText" Foreground="#FF999999" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>

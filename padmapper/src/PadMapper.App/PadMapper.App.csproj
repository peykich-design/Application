<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows 用の本体（WPF + WPF-UI）。Linux でも EnableWindowsTargeting でビルドだけはできる。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PadMapper</AssemblyName>
    <RootNamespace>PadMapper.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinForms と WPF の両方の暗黙 using がぶつからないように -->
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PadMapper.Core\PadMapper.Core.csproj" />
  </ItemGroup>
</Project>
